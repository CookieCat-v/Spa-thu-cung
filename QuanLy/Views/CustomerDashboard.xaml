<Window x:Class="QuanLy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PawSpa - Pet Care"
        Height="850"
        Width="1350"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8F7FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="White"
                Padding="20">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,40">
                        <TextBlock Text="🐾"
                                   FontSize="30"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="PawSpa"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#8064A2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="MENU"
                               Foreground="#999999"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="10,0,0,15"/>

                    <Button Content="Home"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="LightSeaGreen"
                            Foreground="#263238"
                            HorizontalContentAlignment="Left"
                            Padding="5"
                            Margin="0,0,0,5"/>

                    <Button Content="Services"
                            Background="LightSeaGreen"
                            Foreground="#263238"
                            Style="{StaticResource SidebarButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="5"
                            Margin="0,0,0,5"/>

                    <Button Content="Book an appointments"
                            Background="LightSeaGreen"
                            Foreground="#263238"
                            Style="{StaticResource SidebarButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="5"
                            Margin="0,0,0,5"/>

                    

                    

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="0,20">

                    <Separator Margin="0,0,0,15"/>

                    <Button Content="Log out"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            
                            HorizontalContentAlignment="Left"
                            Padding="15"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <!-- TOP BAR -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Welcome to PawSpa!"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#302B3D"/>

                        <TextBlock Text="Give your furry friend the care they deserve."
                                   Foreground="#888888"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Hello, Customer"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                        <Border Width="40"
                                Height="40"
                                Background="#E9DDF5"
                                CornerRadius="20">
                            <TextBlock Text="👤"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- HERO BANNER -->
                <Border Background="#EDE4F6"
                        CornerRadius="18"
                        Padding="30"
                        Margin="0,0,0,30">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPECIAL OFFER"
                                       Foreground="#8064A2"
                                       FontWeight="Bold"
                                       FontSize="12"/>

                            <TextBlock Text="A Happy Pet, A Happy Life!"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#40334F"
                                       Margin="0,10"/>

                            <TextBlock Text="Pamper your pet with our professional grooming and spa services."
                                       TextWrapping="Wrap"
                                       Foreground="#74677E"
                                       FontSize="14"
                                       MaxWidth="480"
                                       Margin="0,0,0,20"/>

                           
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="🐶"
                                   FontSize="105"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!--ABOUT US-->
                <TextBlock Text="About us"
                FontSize="23"
                FontWeight="Bold"
                Foreground="#302B3D"
                Margin="0,0,0,5"/>
                <TextBlock Text="Insert flavor text here"
                 Foreground="Black"
                 FontSize="15"
                 Margin="0,0,0,20"/>
                <!-- SERVICES -->
                <TextBlock Text="Our Services"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#302B3D"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Choose the perfect treatment for your pet."
                           Foreground="#888888"
                           Margin="0,0,0,20"/>

                <UniformGrid Columns="3"
                             Margin="0,0,0,30">

                    <!-- SERVICE 1 -->
                    <Border Background="White"
                            CornerRadius="15"
                            Padding="18"
                            Margin="0,0,12,0">

                        <StackPanel>
                            <TextBlock Text="🛁"
                                       FontSize="35"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Bath &amp; Cleaning"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Bathing, shampoo and fur drying."
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12"/>

                            <TextBlock Text="From 150,000 VND"
                                       Foreground="#8064A2"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <Button Content="More info"
                                    Tag="Bath &amp; Cleaning"
                                   
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#8064A2"/>
                        </StackPanel>
                    </Border>

                    <!-- SERVICE 2 -->
                    <Border Background="White"
                            CornerRadius="15"
                            Padding="18"
                            Margin="6,0">

                        <StackPanel>
                            <TextBlock Text="✂️"
                                       FontSize="35"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Haircut &amp; Styling"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Professional trimming and styling."
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12"/>

                            <TextBlock Text="From 200,000 VND"
                                       Foreground="#8064A2"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <Button Content="More info"
                                    Tag="Haircut &amp; Styling"
                                    
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#8064A2"/>
                        </StackPanel>
                    </Border>

                    <!-- SERVICE 3 -->
                    <Border Background="White"
                            CornerRadius="15"
                            Padding="18"
                            Margin="12,0,0,0">

                        <StackPanel>
                            <TextBlock Text="🐾"
                                       FontSize="35"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Nail &amp; Paw Care"
                                       FontSize="17"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Nail trimming and paw cleaning."
                                       Foreground="#888888"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12"/>

                            <TextBlock Text="From 100,000 VND"
                                       Foreground="#8064A2"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <Button Content="More info"
                                    Tag="Nail &amp; Paw Care"
                                    
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#8064A2"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- BOOKING FORM -->
                <Border Background="White"
                        CornerRadius="15"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Book an Appointment"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#302B3D"/>

                        <TextBlock Text="Fill in the information below to register for a service."
                                   Foreground="#888888"
                                   Margin="0,5,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,15,0">

                                <TextBlock Text="Pet Name"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="PetNameTextBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         ToolTip="Enter your pet's name"
                                         Text="{Binding SelectedAppointment.PetName,UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Pet Type"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="PetTypeComboBox"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          ToolTip="Select pet type"
                                           SelectedValuePath="Content"
                                          SelectedValue="{Binding SelectedAppointment.PetType,UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,15">
                                    <ComboBoxItem Content="Dog"/>
                                    <ComboBoxItem Content="Cat"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>

                                <TextBlock Text="Service"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="ServiceComboBox"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding SelectedAppointment.ServiceName,UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Select a service"
                                          Margin="0,0,0,15">
                                    <ComboBoxItem Content="Bath &amp; Cleaning"/>
                                    <ComboBoxItem Content="Haircut &amp; Styling"/>
                                    <ComboBoxItem Content="Nail &amp; Paw Care"/>
                                </ComboBox>

                            </StackPanel>

                            <!-- RIGHT COLUMN -->
                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0">

                                <TextBlock Text="Customer Name"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="CustomerNameTextBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         ToolTip="Enter your name"
                                         Text="{Binding SelectedAppointment.CustomerName,UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Phone Number"
                                           FontWeight="SemiBold"
                                          
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="PhoneTextBox"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         ToolTip="Enter your phone number"
                                          Text="{Binding SelectedAppointment.Phone,UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Appointment Date"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <DatePicker x:Name="AppointmentDatePicker"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Text="{Binding SelectedAppointment.AppointmentDate,UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateFormat="Long"
                                            Margin="0,0,0,15"/>

                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Additional Notes"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,5"/>

                        <TextBox x:Name="NotesTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 ToolTip="Special requests or information about your pet..."
                                 Text="{Binding SelectedAppointment.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 Margin="0,0,0,20"/>

                        <Button Content="Register Appointment"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="LightSeaGreen"
                                Foreground="White"
                                Padding="20,0"
                                HorizontalAlignment="Right"
                                Command="{Binding BookAppointmentCommand}"
                                />

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
