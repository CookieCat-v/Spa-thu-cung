<Window x:Class="QuanLy.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLy.Views"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="LoginWindow" Height="600" Width="800">
    <Grid>
        <materialDesign:ColorZone
  Padding="16"
  materialDesign:ElevationAssist.Elevation="Dp4"
  ClipToBounds="False"
  CornerRadius="10"
            Background="LightSeaGreen"
            Foreground="White"
  Mode="Custom" Height="584" VerticalAlignment="Center"
 >
            <Grid>
                <materialDesign:ColorZone
  Padding="16"
  materialDesign:ElevationAssist.Elevation="Dp4"
  ClipToBounds="False"
  CornerRadius="10"
                    Background="White"
                    Foreground="Black"
  Mode="Custom" Height="420" Margin="31,50,36,0"
 >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="280"/>
                        </Grid.RowDefinitions>
                        <TextBox
 x:Name="NameTextBox"
           Grid.Row="1"
           Grid.Column="1"
           Margin="10,0,50,30"
           BorderBrush="Black"
           BorderThickness="1.0"
           
 materialDesign:HintAssist.HelperText="Helper text longer than error"
 materialDesign:HintAssist.Hint="Name"
>
                            <TextBox.Text>
                                <Binding
     Path="Name"
     UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <domain:NotEmptyValidationRule
         ValidatesOnTargetUpdated="True"
         xmlns:domain="clr-namespace:QuanLy.ViewModels" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <PasswordBox
 x:Name="PasswordBox"
 Grid.Row="2"
 Grid.Column="2"
           BorderBrush="Black"
           BorderThickness="1.0"
           Margin="10,0,50,30"
 materialDesign:HintAssist.HelperText="At least 8 characters"
 materialDesign:HintAssist.Hint="Password"
 materialDesign:TextFieldAssist.HasClearButton="True"
 />
                        <TextBlock
 Padding="0,16"
 Grid.Column="1"
 VerticalAlignment="Top"
 Style="{StaticResource MaterialDesignTitleLargeTextBlock}"
 Text="Login" 
           FontSize="30" Margin="0,0,10,0"
 />
                        <TextBlock
 Padding="0,16"
 VerticalAlignment="Center"
           
 Style="{StaticResource MaterialDesignTitleLargeTextBlock}"
 Text="Please login with your credentials"
           FontSize="15" Grid.Column="1" Margin="0,0,54,0" Grid.RowSpan="2"
 />
                        <Button
 Width="200"
           
           Grid.Row="3"
           Grid.Column="1"
 Content="Sign in"
 IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
 Style="{StaticResource MaterialDesignRaisedButton}"
 
 ToolTip="Resource name: MaterialDesignRaisedLightButton" Margin="35,10,75,238"
 />
                        <Image Source="https://www.shutterstock.com/image-vector/dog-pet-grooming-washing-logo-260nw-2516343051.jpg" Grid.RowSpan="4" Margin="0,-107,0,107"/>
                    </Grid>
                </materialDesign:ColorZone>
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</Window>
