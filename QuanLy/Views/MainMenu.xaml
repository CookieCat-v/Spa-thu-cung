<Window x:Class="QuanLy.Views.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PawSpa - Employee Dashboard"
        Height="850"
        Width="1400"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="White"
                Padding="20">

            <DockPanel>

                <!-- LOGO -->
                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,40">

                        <TextBlock Text="🐾"
                                   FontSize="30"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="PawSpa"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#8064A2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               Margin="10,0,0,15"/>

                    <!-- DASHBOARD -->
                    <Button Content="Dashboard"
                            Tag="Dashboard"
                            Style="{StaticResource SidebarButtonStyle}"
                            
                            Background="#8064A2"
                            Foreground="White"/>

                    <!-- APPOINTMENTS -->
                    <Button Content="Appointments"
                            Tag="Appointments"
                            Style="{StaticResource SidebarButtonStyle}"
                           />

                    <!-- CUSTOMERS -->
                    <Button Content="Customers"
                            Tag="Customers"
                            Style="{StaticResource SidebarButtonStyle}"
                            />

                    <!-- PETS -->
                    <Button Content="Pets"
                            Tag="Pets"
                            Style="{StaticResource SidebarButtonStyle}"
                            />

                    <!-- SERVICES -->
                    <Button Content="Services"
                            Tag="Services"
                            Style="{StaticResource SidebarButtonStyle}"
                            />

                </StackPanel>

                <!-- BOTTOM SIDEBAR -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="0,10,0,15"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="5,0,0,15">

                        <Border Background="#EDE4F6"
                                Width="40"
                                Height="40"
                                CornerRadius="20">

                            <TextBlock Text="👤"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Employee"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Staff Account"
                                       FontSize="11"
                                       Foreground="#999999"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Logout"
                            Tag="Logout"
                            Style="{StaticResource SidebarButtonStyle}"
                            />

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">

            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="#F7F6FA"/>

        </Grid>

    </Grid>
</Window>
