<Window x:Class="QuanLy.Views.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:QuanLy"
        Title="PawSpa - Employee Dashboard"
        Height="850"
        Width="1400"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6FA">
    <Window.Resources>
        <local:NavigationButtonConverter x:Key="NavigationButtonConverter"/>
        <Style x:Key="SidebarButtonStyle"
       TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8064A2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- Hover state -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDE7F6"/>
                    <Setter Property="Foreground" Value="#8064A2"/>
                </Trigger>

                <!-- Selected page state -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource NavigationButtonConverter}">
                            <Binding Path="DataContext.SelectedPage"
                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Tag"
                             RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>

                    <Setter Property="Background" Value="#8064A2"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="White"
                Padding="20">

            <DockPanel>

                <!-- LOGO -->
                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,40">

                        <TextBlock Text="🐾"
                                   FontSize="30"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="PawSpa"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#8064A2"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#AAAAAA"
                               Margin="10,0,0,15"/>

                    <!-- DASHBOARD -->
                    <Button Content="Dashboard"
                            Tag="Dashboard"
                            CommandParameter="Dashboard"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigationCommand}"
                            />

                    <!-- APPOINTMENTS -->
                    <Button Content="Appointments"
                            Tag="Appointments"
                            CommandParameter="Appointments"
                            Style="{StaticResource SidebarButtonStyle}"
                             Command="{Binding NavigationCommand}"
                           />

                    <!-- CUSTOMERS -->
                    

                    <!-- PETS -->
                    <Button Content="Pets"
                            Tag="Pets"
                            CommandParameter="Pets"
                            Style="{StaticResource SidebarButtonStyle}"
                             Command="{Binding NavigationCommand}"
                            />

                    <!-- SERVICES -->
                  

                </StackPanel>

                <!-- BOTTOM SIDEBAR -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="0,10,0,15"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="5,0,0,15">

                        <Border Background="#EDE4F6"
                                Width="40"
                                Height="40"
                                CornerRadius="20">

                            <TextBlock Text="👤"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Employee"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Staff Account"
                                       FontSize="11"
                                       Foreground="#999999"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Logout"
                            Tag="Logout"
                            CommandParameter="Logout"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigationCommand}"
                            />

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">

            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="#F7F6FA"/>

        </Grid>

    </Grid>
</Window>
