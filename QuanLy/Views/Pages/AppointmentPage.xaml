<Page x:Class="QuanLy.Views.Pages.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#F7F6FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Appointments"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#302B3D"/>

            <TextBlock Text="Manage customer bookings and appointment schedules."
                       Foreground="#888888"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- SEARCH AND FILTER -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         ToolTip="Search customer, pet or phone..."
                         TextChanged="SearchTextBox_TextChanged"
                         Margin="0,0,15,0"/>

                <ComboBox x:Name="StatusFilter"
                          Grid.Column="1"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectedIndex="0"
                         SelectionChanged="StatusFilter_SelectionChanged"
                          Margin="0,0,15,0" VerticalAlignment="Bottom">

                    <ComboBoxItem Content="All Status"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Confirmed"/>
                    <ComboBoxItem Content="Completed"/>
                    <ComboBoxItem Content="Cancelled"/>

                </ComboBox>

                <Button Grid.Column="2"
                        Content="Refresh"
                        Click="Refresh_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                       />

            </Grid>
        </Border>

        <!-- APPOINTMENT TABLE -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="Booking List"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <DataGrid x:Name="AppointmentGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionChanged="AppointmentGrid_SelectionChanged"
                          RowHeight="55"
                          Background="White"
                          >

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                            Binding="{Binding Id}"
                            Width="65"/>

                        <DataGridTextColumn Header="Customer"
                            Binding="{Binding CustomerName}"
                            Width="*"/>

                        <DataGridTextColumn Header="Phone"
                            Binding="{Binding Phone}"
                            Width="*"/>

                        <DataGridTextColumn Header="Pet"
                            Binding="{Binding PetName}"
                            Width="*"/>

                        <DataGridTextColumn Header="Pet Type"
                            Binding="{Binding PetType}"
                            Width="*"/>

                        <DataGridTextColumn Header="Service"
                            Binding="{Binding ServiceName}"
                            Width="1.4*"/>

                        <DataGridTextColumn Header="Date"
                            Binding="{Binding AppointmentDate, StringFormat={}{0:dd/MM/yyyy}}"
                            Width="*"/>

                        <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>
        </Border>
    </Grid>
</Page>
